# 编译产物（各工具用 go build 自行生成）
*.exe
*.test
*.out
/bin/
/dist/

# 例外：windows-env 的 env.exe 是**要分发的启动器成品**
# （clone 后免装 Go 工具链即可一键起 etcd / nats / redis / mysql），随仓库走。
# 必须写成例外而不是每次 `git add -f`：被忽略的文件重新编译后**不会**出现在
# `git status` 里，成品会在无人察觉的情况下静默过期。
!windows-env/core/env.exe

# 运行期日志与临时数据
*.log
/logs/

# 本地 TLS 证书（本机用 mkcert 生成，不入库）
mkcert/certs/
msg-web/certs/*.pem

# windows-env 的中间件二进制（etcd / mysql / nats / redis，合计约 1.8 GB）
# 体积大、属第三方发行物，本机安装或下载即可，不入库；启动脚本（*.bat / *.vbs）与之分离，正常入库
windows-env/etcd/
windows-env/mysql/
windows-env/nats/
windows-env/redis/
windows-env/core/logs/
windows-env/core/run/

# 系统文件
.DS_Store
Thumbs.db
